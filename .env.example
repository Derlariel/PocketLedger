# Public values from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Required only for the OCR worker and orphan cleanup job.
SUPABASE_SECRET_KEY=sb_secret_replace_me
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-value

# OCR is disabled when these are blank. The endpoint must accept the documented
# PocketLedger JSON contract; the provider/model name is never hard-coded.
OCR_PROVIDER=
OCR_ENDPOINT=
OCR_API_KEY=
OCR_MODEL=
OCR_MAX_RETRIES=3
UPLOADS_PER_HOUR=50
OCR_JOBS_PER_HOUR=30
